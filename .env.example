# Database — same Postgres instance as the gateway
DATABASE_URL=postgres://volund:volund@localhost:5432/volund?sslmode=disable

# Must match VOLUND_JWT_SECRET on the gateway
JWT_SECRET=dev-secret-change-me

# Auth service port
PORT=3456

# Trusted origins (comma-separated) — CORS
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

# Base URL of this auth service (used for OAuth redirect callbacks)
AUTH_BASE_URL=http://localhost:3456

# Optional: OIDC providers (JSON array)
# Each entry: { "providerId": "google", "clientId": "...", "clientSecret": "...", "issuerUrl": "https://accounts.google.com" }
# OIDC_PROVIDERS=[]
